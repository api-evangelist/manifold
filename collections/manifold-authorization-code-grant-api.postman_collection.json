  "info": {
    "_postman_id": "edfa6e9f-f537-4418-a396-680f5b1815b6",
    "name": "Manifold OAuth2 Authentication Authorization Code Grant API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Server-side session authentication API for validating wallet addresses of authenticated Manifold clients. Supports two grant types: Signature Grant (POST /verify to confirm a wallet signature session token) and Authorization Code Grant (POST /token to exchange a one-time code for a 30-day access token). Enables backends to securely access and modify private user data without exposing session keys client-side. Requires a Developer App configured at the Manifold Developer Portal.\n\nContact Support:\n Name: Manifold",
      "type": "text/plain"
    }
  }
