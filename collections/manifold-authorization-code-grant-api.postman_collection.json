      "name": "Authorization Code Grant",
      "description": {
        "content": "Exchange a one-time authorization code for a long-lived access token allowing server-side access to private user data.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4f676211-0d60-4150-8e0a-12168d55a51c",
          "name": "Exchange an authorization code for an access token",
          "request": {
            "name": "Exchange an authorization code for an access token",
            "description": {
              "content": "Exchanges a one-time authorization code (obtained after a user completes the Manifold OAuth2 flow) for a 30-day access token. The access token can then be used server-side to read and modify private user data. Requires credentials from a Developer App configured at the Manifold Developer Portal.",
              "type": "text/plain"
            },
